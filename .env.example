# Dollar Store - Environment Variables (template)
# Copy the relevant block into a per-target file and fill in your values:
#   .env.local    -> local / anvil quick deploys (script/Deploy.s.sol)
#   .env.sepolia  -> testnet rehearsal            (script/DeployGovernance.s.sol)
#   .env.mainnet  -> production launch            (script/DeployGovernance.s.sol)
# NEVER commit a filled .env* file. Only this template is meant to be shared.
#
# Which file per network (runbook). Use `set -a` so the vars are EXPORTED to forge
# (a plain `source` does not export them). --rpc-url uses the foundry.toml alias.
#   set -a; source .env.sepolia; set +a
#   forge script script/DeployGovernance.s.sol:DeployGovernance --rpc-url sepolia --broadcast --verify
#   set -a; source .env.mainnet; set +a
#   forge script script/DeployGovernance.s.sol:DeployGovernance --rpc-url mainnet --broadcast --verify
# --verify uses the [etherscan] config in foundry.toml (ETHERSCAN_API_KEY). It verifies the impl,
# the two timelocks and the proxy. If DLRS (deployed inside initialize) is not auto-verified, run:
#   forge verify-contract <DLRS_ADDR> src/DLRS.sol:DLRS --chain sepolia \
#     --constructor-args $(cast abi-encode "constructor(address)" <PROXY_ADDR>)

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Get one from https://alchemy.com or https://infura.io
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Broadcasting key. MUST include the 0x prefix (forge's vm.envUint parses it as a number).
# WARNING: never share or commit this.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key for contract verification (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# =============================================================================
# ROLES / GOVERNANCE
# =============================================================================
# On-chain roles: upgrader (UUPS upgrades), governor (risk/registry/caps), guardian (tightens caps,
# haircuts escrow after a loss), pausers (pause only) and unpauser (lifts pauses, sets pausers).
# See SECURITY.md.

# --- script/Deploy.s.sol (local / anvil: roles are plain addresses) ---
# All optional; each defaults to the deployer if unset. Timelocks/Safes are NOT used here.
UPGRADER=
GOVERNOR=
GUARDIAN=
UNPAUSER=
PAUSER=

# --- script/DeployGovernance.s.sol (sepolia / mainnet: 2 timelocks + Safes) ---
# The upgrader, governor, guardian, veto and unpauser roles are each operated by a Safe; a pauser can
# be any address. The upgrader/governor timelocks are deployed by the
# script and wrap their operator Safe; the guardian Safe is used directly (no timelock).
# On a testnet you may point them all at the same address. On mainnet use distinct Safes.
UPGRADER_SAFE=                 # required: proposer/canceller of the upgrader timelock
GOVERNOR_SAFE=                 # optional: default = UPGRADER_SAFE
GUARDIAN_SAFE=                 # optional off mainnet: default = UPGRADER_SAFE. On mainnet it must differ from UPGRADER_SAFE, GOVERNOR_SAFE and VETO_SAFE
VETO_SAFE=                     # required: canceller on both timelocks
UNPAUSER_SAFE=                 # required: lifts pauses and sets pausers
PAUSERS=                       # required: comma-separated addresses that may pause, no spaces. At least one
# Timelock min delays in SECONDS. Optional; defaults 1209600 (14d) / 604800 (7d), the mainnet values.
# On Sepolia use 60 / 30 so the rehearsal does not wait.
UPGRADER_DELAY=1209600
GOVERNOR_DELAY=604800
